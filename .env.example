# ==============================================================================
# DailyGurus Price List - Environment Variables Example (Static JSON Architecture)
# ==============================================================================

# Site URL
NEXT_PUBLIC_SITE_URL=https://pricelist.reginaldalfret.tech

# Admin Authentication Secret (Optional for local dev; min 16 chars if set)
ADMIN_JWT_SECRET=your-random-secure-jwt-secret-key-32-chars-min
ADMIN_USER=Reginald
ADMIN_PASSWORD=your-secure-admin-password

# Google Analytics 4 Measurement ID (Official Google tag / gtag.js)
# Optional in local dev (site operates normally without it). Set on Vercel for production tracking.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
